# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.railway.app,*.up.railway.app

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/dbname

# Email Configuration
