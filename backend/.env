# Configurações do Servidor
PORT=3002
NODE_ENV=development

# Configurações do Banco de Dados PostgreSQL (desativado para usar SQLite local)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sapere_db
# DB_USER=postgres
# DB_PASSWORD=admin123

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS Origins (separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload de arquivos
UPLOAD_DIR=./uploads

# Railway Database URL (será preenchida automaticamente no Railway)
# DATABASE_URL=

# WhatsApp API (opcional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Email SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=