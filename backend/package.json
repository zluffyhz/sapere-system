{
  "name": "sapere-backend",
  "version": "1.0.0",
  "description": "Sistema de gestão para clínica de neurodivergentes Sapere - Backend",
  "main": "dist/production-server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "dev:prod": "nodemon src/production-server.ts",
    "build": "tsc",
    "start": "node dist/production-server.js",
    "start:dev": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/production-server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/scripts/init.js",
    "setup:postgres": "psql -f scripts/setup-postgres.sql",
    "migrate:sqlite-to-postgres": "node scripts/migrate-sqlite-to-postgres.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs sapere-backend",
    "deploy": "npm run build && npm run pm2:restart",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.18.1",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.5",
    "pg": "^8.11.3",
    "recharts": "^3.1.2",
    "socket.io": "^4.8.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
