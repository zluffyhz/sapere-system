// Prisma Schema para Sistema Sapere Profissional
// Sistema completo de gestão clínica com funcionalidades específicas de nutrição

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum para tipos de usuário incluindo NUTRICIONISTA
enum UserRole {
  ADMIN
  THERAPIST
  RESPONSIBLE
  NUTRITIONIST // Novo role para nutricionistas
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_INFORMED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  THERAPY
  EVALUATION
  FOLLOW_UP
  NUTRITION_CONSULTATION // Específico para nutricionistas
  NUTRITIONAL_ASSESSMENT
}

enum DocumentType {
  ANAMNESE
  MEDICAL_REPORT
  PRESCRIPTION
  NUTRITION_PLAN
  PROGRESS_REPORT
  EXAM_RESULT
  PHOTO
  OTHER
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// === TABELAS PRINCIPAIS ===

// Usuários do sistema (profissionais e responsáveis)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String?  @unique
  password  String
  name      String
  phone     String?
  role      UserRole @default(THERAPIST)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  // Dados profissionais específicos
  professionalId String?   @unique // CRP, CRN, etc.
  specialties    String[]  // Array de especialidades
  bio            String?
  experienceYears Int?     @default(0)
  languages      String[]  @default(["Português"])

  // Configurações profissionais
  consultationDuration   Int? @default(50) // minutos
  maxDailyAppointments  Int? @default(8)
  workingDays           String[] @default(["MON", "TUE", "WED", "THU", "FRI"])
  workingHours          Json? // { start: "08:00", end: "17:00" }

  // Relacionamentos
  createdPatients    Patient[]     @relation("CreatedByUser")
  appointments       Appointment[] @relation("AppointmentProfessional")
  sessions          Session[]
  documents         Document[]    @relation("DocumentUploadedBy")
  anamneses         Anamnesis[]

  // Específico para nutricionistas
  nutritionPlans     NutritionPlan[]
  nutritionAssessments NutritionAssessment[]

  // Auditoria
  createdBy    String?
  lastModifiedBy String?

  @@map("users")
  @@index([role, status])
}

// Pacientes
model Patient {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  cpf       String?  @unique
  rg        String?
  birthDate DateTime?
  gender    Gender   @default(NOT_INFORMED)

  // Endereço
  address    String?
  city       String?
  state      String?
  zipCode    String?

  // Contato de emergência
  emergencyContact     String?
  emergencyContactPhone String?

  // Dados médicos gerais
  medicalHistory       String?
  currentMedications   String?
  allergies           String?
  observations        String?

  // Responsável (para menores de idade)
  responsibleName     String?
  responsiblePhone    String?
  responsibleEmail    String?
  responsibleRelation String?

  // Metadados
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  createdByUser User   @relation("CreatedByUser", fields: [createdBy], references: [id])

  // Relacionamentos
  appointments         Appointment[]
  sessions            Session[]
  documents           Document[]
  anamneses           Anamnesis[]
  nutritionPlans      NutritionPlan[]
  nutritionAssessments NutritionAssessment[]

  @@map("patients")
  @@index([isActive, createdAt])
}

// Agendamentos
model Appointment {
  id          String    @id @default(uuid())
  patientId   String
  professionalId String

  dateTime    DateTime
  duration    Int      @default(50) // minutos
  type        AppointmentType
  status      AppointmentStatus @default(SCHEDULED)

  title       String?
  description String?
  notes       String?

  // Dados específicos
  isRecurring      Boolean @default(false)
  recurringPattern String? // "WEEKLY", "BIWEEKLY", "MONTHLY"
  recurringUntil   DateTime?

  // Cancelamento
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?

  // Confirmação
  confirmedAt DateTime?
  confirmedBy String?

  // Metadados
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional User    @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  session      Session?

  @@map("appointments")
  @@index([professionalId, dateTime])
  @@index([patientId, status])
}

// Sessões/Consultas realizadas
model Session {
  id            String   @id @default(uuid())
  appointmentId String?  @unique
  patientId     String
  professionalId String

  startTime     DateTime
  endTime       DateTime?
  duration      Int? // minutos efetivos
  status        SessionStatus @default(IN_PROGRESS)

  // Conteúdo da sessão
  objectives    String?
  activities    String?
  observations  String?
  evolution     String? // NOVO CAMPO - Evolução do paciente durante a consulta
  homework      String?
  nextSteps     String?

  // Avaliação
  patientMood       String?
  sessionQuality    Int? // 1-5
  professionalNotes String?

  // Dados específicos para nutrição
  currentWeight  Float?
  currentHeight  Float?
  bloodPressure  String?
  heartRate      Int?

  // Metadados
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional User        @relation(fields: [professionalId], references: [id])
  documents    Document[]

  @@map("sessions")
  @@index([professionalId, startTime])
}

// Documentos e arquivos
model Document {
  id          String   @id @default(uuid())
  patientId   String
  sessionId   String?
  uploadedBy  String

  fileName    String
  originalName String
  filePath    String
  fileSize    Int
  mimeType    String
  type        DocumentType

  title       String?
  description String?
  tags        String[]

  // Versionamento
  version     Int     @default(1)
  parentId    String? // Para versionamento
  isLatest    Boolean @default(true)

  // Permissões
  isPublic    Boolean @default(false)
  allowedRoles UserRole[]

  // Metadados
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  uploadedByUser User  @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id])
  parent      Document? @relation("DocumentVersions", fields: [parentId], references: [id])
  versions    Document[] @relation("DocumentVersions")

  @@map("documents")
  @@index([patientId, type])
}

// Anamneses
model Anamnesis {
  id            String   @id @default(uuid())
  patientId     String
  professionalId String

  type          String   // "INITIAL", "FOLLOW_UP", "SPECIALIZED"
  title         String
  content       Json     // Estrutura flexível para diferentes tipos

  // Dados específicos
  mainComplaint     String?
  currentHistory    String?
  pastHistory       String?
  familyHistory     String?
  socialHistory     String?

  // Status
  isCompleted   Boolean @default(false)
  completedAt   DateTime?

  // Metadados
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relacionamentos
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional  User    @relation(fields: [professionalId], references: [id])

  @@map("anamneses")
}

// === TABELAS ESPECÍFICAS PARA NUTRIÇÃO ===

// Planos nutricionais
model NutritionPlan {
  id              String   @id @default(uuid())
  patientId       String
  nutritionistId  String

  title           String
  description     String?

  // Objetivos e metas
  goals           String[]
  targetWeight    Float?
  targetCalories  Int?
  targetProtein   Float?
  targetCarbs     Float?
  targetFat       Float?

  // Plano alimentar
  mealPlan        Json     // Estrutura com refeições e horários
  restrictions    String[] // Restrições alimentares
  allergies       String[] // Alergias alimentares
  preferences     String[] // Preferências

  // Orientações
  instructions    String?
  observations    String?

  // Validade
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean  @default(true)

  // Metadados
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacionamentos
  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist    User    @relation(fields: [nutritionistId], references: [id])

  @@map("nutrition_plans")
  @@index([patientId, isActive])
}

// Avaliações nutricionais
model NutritionAssessment {
  id              String   @id @default(uuid())
  patientId       String
  nutritionistId  String

  assessmentDate  DateTime @default(now())

  // Medidas antropométricas
  weight          Float?
  height          Float?
  bmi             Float?
  waistCirc       Float?
  hipCirc         Float?
  bodyFat         Float?
  muscleMass      Float?

  // Cálculos metabólicos
  bmr             Float?   // Taxa metabólica basal
  tdee            Float?   // Gasto energético total

  // Avaliação dietética
  currentDiet     String?
  eatingHabits    String?
  supplementation String?
  hydration       String?

  // Avaliação clínica
  bloodTests      Json?    // Exames laboratoriais
  vitalSigns      Json?    // Sinais vitais
  clinicalSigns   String?  // Sinais clínicos

  // Objetivos e recomendações
  goals           String[]
  recommendations String?
  nextAssessment  DateTime?

  // Metadados
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacionamentos
  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nutritionist    User    @relation(fields: [nutritionistId], references: [id])

  @@map("nutrition_assessments")
  @@index([patientId, assessmentDate])
}

