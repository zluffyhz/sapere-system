# Configurações do Servidor
PORT=3001
NODE_ENV=production

# Configurações do Banco de Dados PostgreSQL (Railway irá fornecer)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT Secret (gerar um novo para produção)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# CORS Origins (separados por vírgula)
CORS_ORIGINS=https://seu-frontend.railway.app,https://sapere-frontend.railway.app

# Upload de arquivos
UPLOAD_DIR=./uploads

# WhatsApp API (opcional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Email SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EOF < /dev/null