# Configurações de Produção - VPS Hostinger
NODE_ENV=production
PORT=3002

# Banco de dados
# Em produção, usar PostgreSQL se disponível, senão SQLite
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=sapere_production
DB_USER=
DB_PASSWORD=

# Segurança
JWT_SECRET=sua_chave_jwt_super_segura_aqui_com_mais_de_32_chars
BCRYPT_ROUNDS=12

# CORS - Substituir pelos domínios reais
CORS_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com

# Uploads e Backups
UPLOAD_DIR=/var/www/sapere/uploads
BACKUP_DIR=/var/www/sapere/backups

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# SSL/TLS
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key

# Logs
LOG_LEVEL=info
LOG_DIR=/var/log/sapere

# Email (para notificações, se necessário)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@seu-dominio.com

# Configurações da Clínica
CLINIC_NAME=Clínica Sapere
CLINIC_PHONE=(92) 99230-5850
CLINIC_EMAIL=Sapere.recepcao@gmail.com
CLINIC_WHATSAPP=+5592992305850