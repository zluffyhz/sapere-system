# Configurações de produção para Railway
NODE_ENV=production
PORT=3001

# Database - Railway PostgreSQL (use actual Railway environment variables)
# DATABASE_URL will be provided by Railway deployment
# DB_HOST will be provided by Railway as PGHOST  
# DB_PORT will be provided by Railway as PGPORT
# DB_NAME will be provided by Railway as PGDATABASE
# DB_USER will be provided by Railway as PGUSER
# DB_PASSWORD will be provided by Railway as PGPASSWORD

# Development fallbacks (override these in production)
DATABASE_URL=postgresql://localhost:5432/sapere_development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sapere_development
DB_USER=postgres
DB_PASSWORD=postgres

# JWT (provide actual secret in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Upload configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/app/uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
LOGIN_RATE_LIMIT_MAX=5

# CORS Origins (separados por vírgula)
CORS_ORIGINS=https://sapere-system.vercel.app,https://sapere-system-*.vercel.app

# Security
TRUST_PROXY=true
SECURE_COOKIES=true