# Configurações de produção para o frontend
VITE_APP_TITLE=Sistema Sapere
VITE_APP_VERSION=1.0.0
# VITE_API_URL=https://sapere-system-production.up.railway.app/api
# Using Vercel API routes instead - leave blank for relative URLs
VITE_SOCKET_URL=/
VITE_APP_ENV=production

# Configurações de segurança
VITE_ENABLE_DEBUG=false
VITE_ENABLE_CONSOLE_LOGS=false

# Configurações da clínica
VITE_CLINIC_NAME=Clínica Sapere
VITE_CLINIC_PHONE=(92) 99230-5850
VITE_CLINIC_EMAIL=Sapere.recepcao@gmail.com
VITE_CLINIC_WHATSAPP=+5592992305850

# Configurações de upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# PWA (se implementado no futuro)
VITE_PWA_NAME=Sapere
VITE_PWA_SHORT_NAME=Sapere
VITE_PWA_DESCRIPTION=Sistema de gestão para clínicas de neurodivergentes